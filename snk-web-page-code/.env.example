# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="TU_GEMINI_API_KEY"

# URL HTTPS pública de la tienda; Bold regresa aquí después del pago.
APP_URL="https://TU_DOMINIO_EN_VERCEL"

# Supabase: la URL y la clave anon/publishable se pueden usar en el navegador.
VITE_SUPABASE_URL=https://TU_PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=TU_CLAVE_ANON_PUBLICA

# Solo backend/Vercel. Nunca usar el prefijo VITE_ en estas claves.
SUPABASE_URL=https://TU_PROYECTO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=TU_SERVICE_ROLE_KEY
BOLD_API_KEY=TU_LLAVE_DE_IDENTIDAD_BOLD_BOTON_DE_PAGOS
BOLD_SECRET_KEY=TU_LLAVE_SECRETA_BOLD_BOTON_DE_PAGOS
